{
  "name": "dsh-plugin-mcp-toggles",
  "version": "0.2.1",
  "type": "module",
  "description": "Turn installed MCP servers on or off per conversation, from a picker in the session header.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "plugin"
  ],
  "homepage": "https://github.com/ZEN-GUO/dsh-plugin-mcp-toggles#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZEN-GUO/dsh-plugin-mcp-toggles.git"
  },
  "bugs": {
    "url": "https://github.com/ZEN-GUO/dsh-plugin-mcp-toggles/issues"
  },
  "author": "ZhaoHanshao; fork maintained by ZEN-GUO",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/project.js",
    "lib/origin.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "node --check lib/index.js && node --check lib/client.js && node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  }
}
